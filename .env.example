# App runtime connection — a restricted, non-superuser Postgres role.
# PostgreSQL Row-Level Security policies are silently bypassed by superusers
# and table owners, so this must NOT be the same role that owns the schema.
# See drizzle/0001_row_level_security.sql and docs/security.md §2.
DATABASE_URL="postgresql://mm_app:change-me@localhost:5432/money_matters?schema=public"

# Migration connection — owns the tables, creates the mm_app role/grants/RLS
# policies (`npm run db:migrate`). Never used by the running application.
DIRECT_DATABASE_URL="postgresql://postgres:change-me@localhost:5432/money_matters?schema=public"

# Same pair, pointed at an isolated database, used by integration tests
# (src/tests/integration). Never point this at a database with real data.
TEST_DATABASE_URL="postgresql://mm_app:change-me@localhost:5432/money_matters_test?schema=public"
TEST_DIRECT_DATABASE_URL="postgresql://postgres:change-me@localhost:5432/money_matters_test?schema=public"

# The mm_app role's password. `npm run db:migrate` writes this to the role on
# every run (the RLS migration creates it with NOLOGIN and no password — see
# drizzle/0001_row_level_security.sql).
#
# In a deployment, prefer setting ONLY this and leaving DATABASE_URL unset:
# the application's connection is then derived from this password plus the
# host/database in DIRECT_DATABASE_URL, so the password lives in exactly one
# place and cannot drift out of sync with the role. Left unset entirely,
# src/db/migrate.ts generates a random password on first run and prints the
# resulting connection string once to that build's own log.
MM_APP_DB_PASSWORD="change-me"

# --- Optional connection tuning -------------------------------------------
# PEM-encoded CA certificate for the database's TLS chain. Without it, hosted
# connections are encrypted but the server certificate is NOT verified
# (protects against passive interception, not an active MITM) — see
# docs/security.md. Local connections never use TLS.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Max pooled connections per app instance (default 5). Keep this small on
# serverless platforms so many instances stay inside the database's limit.
# DATABASE_POOL_MAX="5"
# DATABASE_CONNECT_TIMEOUT_MS="10000"

# NextAuth (Credentials provider, JWT sessions — see docs/decisions/0002-auth-strategy.md)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-value"
