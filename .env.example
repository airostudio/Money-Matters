# App runtime connection — a restricted, non-superuser Postgres role.
# PostgreSQL Row-Level Security policies are silently bypassed by superusers
# and table owners, so this must NOT be the same role that owns the schema.
# See drizzle/0001_row_level_security.sql and docs/security.md §2.
DATABASE_URL="postgresql://mm_app:change-me@localhost:5432/money_matters?schema=public"

# Migration connection — owns the tables, creates the mm_app role/grants/RLS
# policies (`npm run db:migrate`). Never used by the running application.
DIRECT_DATABASE_URL="postgresql://postgres:change-me@localhost:5432/money_matters?schema=public"

# Same pair, pointed at an isolated database, used by integration tests
# (src/tests/integration). Never point this at a database with real data.
TEST_DATABASE_URL="postgresql://mm_app:change-me@localhost:5432/money_matters_test?schema=public"
TEST_DIRECT_DATABASE_URL="postgresql://postgres:change-me@localhost:5432/money_matters_test?schema=public"

# The mm_app role's password. `npm run db:migrate` writes this to the role on
# every run (the RLS migration creates it with NOLOGIN and no password — see
# drizzle/0001_row_level_security.sql).
#
# In a deployment, prefer setting ONLY this and leaving DATABASE_URL unset:
# the application's connection is then derived from this password plus the
# host/database in DIRECT_DATABASE_URL, so the password lives in exactly one
# place and cannot drift out of sync with the role. Left unset entirely,
# src/db/migrate.ts generates a random password on first run and prints the
# resulting connection string once to that build's own log.
MM_APP_DB_PASSWORD="change-me"

# --- Optional connection tuning -------------------------------------------
# PEM-encoded CA certificate for the database's TLS chain. Without it, hosted
# connections are encrypted but the server certificate is NOT verified
# (protects against passive interception, not an active MITM) — see
# docs/security.md. Local connections never use TLS.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Max pooled connections per app instance (default 3). Keep this small on
# serverless platforms: the cap that matters is the DATABASE's pooler limit
# (e.g. Supabase's session-mode pooler, commonly 15 clients on smaller
# tiers), divided across however many serverless instances are warm at
# once — not per request. 5 warm instances at max=5 can demand 25
# connections against a 15-client pool and get EMAXCONNSESSION; at max=3
# the same 5 instances top out at 15. Raise this only alongside confirming
# the database's actual pool/client limit.
# DATABASE_POOL_MAX="3"
# DATABASE_CONNECT_TIMEOUT_MS="10000"

# NextAuth (Credentials provider, JWT sessions — see docs/decisions/0002-auth-strategy.md)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-value"

# Platform admin section (/admin): comma-separated emails that may access it.
# Server-side only, never sent to the client. Compared trimmed + case-insensitively.
# FAILS CLOSED: unset or empty means nobody is an admin. There is no email
# verification, so register this account yourself first — see docs/security.md §10.
PLATFORM_ADMIN_EMAILS="typhoon.tall69@gmail.com"

# --- Optional: AI-assisted onboarding (docs/ai-agents.md) -------------------
# Entirely optional. The onboarding wizard's chart-of-accounts recommender
# works with no API key at all, no network access, and full test coverage —
# it just uses a deterministic keyword classifier instead of Claude. Set
# ANTHROPIC_API_KEY to turn on the AI-assisted classification step; leave it
# unset in dev/CI/tests.
# ANTHROPIC_API_KEY="sk-ant-..."
# Model used for onboarding classification only. Defaults to a fast/cheap
# model since this is a small structured-classification call, not a
# freeform chat — see docs/ai-agents.md.
# ANTHROPIC_ONBOARDING_MODEL="claude-haiku-4-5-20251001"

# --- Optional: AI-assisted fuzzy bank reconciliation (docs/ai-agents.md) ---
# Same ANTHROPIC_API_KEY as above turns this on too. A user-triggered
# ("Get AI suggestions") second pass for bank transactions with no
# exact-amount deterministic candidate — never automatic, never posts
# anything itself. Falls back to "no AI section" with no error on a missing
# key, a failed call, or a schema validation failure.
# ANTHROPIC_RECONCILIATION_MODEL="claude-haiku-4-5-20251001"

# --- Optional: Document AI receipt/invoice capture (docs/ai-agents.md) -----
# Same ANTHROPIC_API_KEY as above turns this on too. Extracts structured
# data from an uploaded receipt/invoice image or PDF using Claude's vision
# capability, purely to pre-fill an editable expense claim draft a human
# must still confirm — never posted automatically. Falls back to a blank
# draft on a missing key or a failed/invalid extraction. Defaults to a
# stronger model than the other two calls since vision extraction benefits
# from it.
# ANTHROPIC_DOCUMENT_AI_MODEL="claude-sonnet-4-5-20250929"

# --- Optional: webhooks and integration credentials (docs/api.md "Webhooks", docs/security.md sections 16 and 19) -
# Webhook signing secrets and integration credentials (e.g. a Slack incoming-webhook
# URL, Settings -> Integrations) must be stored in a recoverable form (signing and
# sending need the raw value), so they are encrypted at rest with AES-256-GCM under
# THIS ONE key, which lives only in the environment, never in the database. No new
# variable is needed for integrations. 32 random bytes, base64:
#   openssl rand -base64 32
# FAILS CLOSED: unset or invalid means webhooks AND integration connections are
# disabled (nothing can be created, nothing is delivered or sent, Settings says so) -
# the build and the rest of the app, including automations that do not send to a
# channel, are unaffected. Keep it stable: losing or changing it makes the stored
# secrets undecryptable (rotate each subscription's secret to recover).
# WEBHOOK_SECRET_ENCRYPTION_KEY="..."
# Key rotation: set the NEW key above, set its version here (1..255, default 1), and
# keep each OLD key as WEBHOOK_SECRET_ENCRYPTION_KEY_V<its version> so existing
# ciphertexts still decrypt; secrets are re-encrypted when a subscription's secret is
# next rotated.
# WEBHOOK_SECRET_ENCRYPTION_KEY_VERSION="2"
# WEBHOOK_SECRET_ENCRYPTION_KEY_V1="..."

# --- Outbound email (Resend) ---
# Inert and FAILS CLOSED unless ALL THREE are set: nothing is ever sent otherwise.
# Owner steps: create a Resend account, verify the sending domain, create an API key
# (sending access only), then set these on the host.
# EMAIL_PROVIDER="resend"
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Money Matters <billing@your-verified-domain.example>"
